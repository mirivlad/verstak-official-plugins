{
  "schemaVersion": 1,
  "id": "verstak.notes",
  "name": "Notes",
  "version": "0.1.0",
  "apiVersion": "0.1.0",
  "description": "Deal-scoped notes manager for Markdown files in canonical Notes folders with create, rename, trash, and Workbench integration.",
  "localization": {
    "defaultLocale": "en",
    "locales": {
      "en": "locales/en.json",
      "ru": "locales/ru.json"
    }
  },
  "source": "official",
  "icon": "edit",
  "provides": [
    "verstak/notes/v1",
    "verstak/notes/v2"
  ],
  "requires": [
    "verstak/core/files/v1",
    "verstak/core/workbench/v1"
  ],
  "permissions": [
    "files.read",
    "files.write",
    "files.delete",
    "storage.namespace",
    "events.subscribe",
    "workbench.open",
    "ui.register",
    "commands.register"
  ],
  "frontend": {
    "entry": "frontend/src/index.js"
  },
  "contributes": {
    "workspaceItems": [
      {
        "id": "verstak.notes.workspace",
        "title": "Notes",
        "icon": "edit",
        "order": 10,
        "component": "NotesView"
      }
    ],
    "commands": [
      {
        "id": "verstak.notes.provideOverview",
        "title": "Provide Overview Signals",
        "handler": "verstak.notes.provideOverview"
      },
      {
        "id": "verstak.notes.list",
        "title": "List Notes",
        "handler": "verstak.notes.list"
      },
      {
        "id": "verstak.notes.create",
        "title": "Create Note",
        "handler": "verstak.notes.create"
      },
      {
        "id": "verstak.notes.open",
        "title": "Open Note",
        "handler": "verstak.notes.open"
      }
    ],
    "overviewProviders": [
      {
        "id": "verstak.notes.overview",
        "label": "Notes",
        "handler": "verstak.notes.provideOverview"
      }
    ]
  },
  "capabilityOperations": {
    "verstak/notes/v1": {
      "list": "verstak.notes.list",
      "create": "verstak.notes.create",
      "open": "verstak.notes.open"
    },
    "verstak/notes/v2": {
      "list": "verstak.notes.list",
      "create": "verstak.notes.create",
      "open": "verstak.notes.open"
    }
  }
}
