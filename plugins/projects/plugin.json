      }
    ],
    "sidebarItems": [
      {
        "id": "verstak.projects.sidebar",
        "title": "Project portfolio",
        "icon": "folder",
        "view": "verstak.projects.view",
        "position": 34
      }
    ],
    "workspaceItems": [
      {
        "id": "verstak.projects.workspace",
        "title": "Project Meta",
        "icon": "folder",
        "order": 5,
        "component": "ProjectMetaView"
      }
    ]
  }
}
