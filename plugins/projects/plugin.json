{
  "schemaVersion": 1,
  "id": "verstak.projects",
  "name": "Project Meta",
  "version": "0.3.0",
  "apiVersion": "0.1.0",
  "description": "Deal-owned project metadata and a global portfolio view.",
  "localization": {
    "defaultLocale": "en",
    "locales": {
      "en": "locales/en.json",
      "ru": "locales/ru.json"
    }
  },
  "source": "official",
  "icon": "folder",
  "provides": [
    "verstak/project-meta/v1"
  ],
  "permissions": [
    "storage.namespace",
    "ui.register"
  ],
  "frontend": {
