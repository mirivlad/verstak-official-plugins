{
  "schemaVersion": 1,
  "id": "verstak.git",
  "name": "Git",
  "version": "0.1.0",
  "apiVersion": "0.1.0",
  "description": "Multiple Git repository descriptors per Deal.",
  "localization": {"defaultLocale": "en", "locales": {"en": "locales/en.json", "ru": "locales/ru.json"}},
  "source": "official",
  "icon": "git-branch",
  "provides": ["verstak/git/v1"],
  "permissions": ["storage.namespace", "ui.register", "commands.register", "secrets.read"],
  "sync": {"records": [{"id": "repositories", "storage": "data", "name": "repositories", "identity": "id"}]},
  "frontend": {"entry": "frontend/src/index.js"},
  "contributes": {
    "views": [{"id": "verstak.git.view", "title": "Git", "icon": "git-branch", "component": "GitView"}],
    "sidebarItems": [{"id": "verstak.git.sidebar", "title": "Git", "icon": "git-branch", "view": "verstak.git.view", "position": 37}],
    "workspaceItems": [{"id": "verstak.git.workspace", "title": "Git", "icon": "git-branch", "order": 37, "component": "GitView"}],
    "commands": [
      {"id": "verstak.git.list", "title": "List Git Repositories", "handler": "verstak.git.list"},
      {"id": "verstak.git.add", "title": "Add Git Repository", "handler": "verstak.git.add"},
      {"id": "verstak.git.update", "title": "Update Git Repository", "handler": "verstak.git.update"},
      {"id": "verstak.git.remove", "title": "Remove Git Repository", "handler": "verstak.git.remove"}
    ]
  },
  "capabilityOperations": {"verstak/git/v1": {"list": "verstak.git.list", "add": "verstak.git.add", "update": "verstak.git.update", "remove": "verstak.git.remove"}}
}
